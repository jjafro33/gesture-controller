{
  "manifest_version": 3,
  "name": "NT Console Bridge",
  "version": "1.0.0",
  "description": "Receives gesture commands from the NT Console web app and converts them into real keyboard, mouse, scroll, and fullscreen events on your active tab. Works with Poki, YouTube, Google Slides, Canva, and any HTML5 game.",
  "permissions": ["tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "NT Console Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
